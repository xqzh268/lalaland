<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="LaLaLand.Views.IslandWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:LaLaLand.Controls"
    Title="LaLaLand Island">

    <!--
        The window is sized for the largest state and stays put; only the island's rounded clip animates
        (on the compositor thread), and a window region keeps the transparent remainder click-through.
    -->
    <Grid x:Name="Root" Background="Transparent" RequestedTheme="Dark">
        <Grid x:Name="Host" HorizontalAlignment="Left" VerticalAlignment="Top">
            <Grid.RenderTransform>
                <ScaleTransform x:Name="UserScaleTransform" />
            </Grid.RenderTransform>

            <Grid x:Name="Island">
                <!-- Material layers (the host-backdrop blur, when enabled, is drawn by the system behind all of these) -->
                <Rectangle x:Name="BaseFill" Fill="Black" />
                <Image x:Name="BackdropA" Stretch="UniformToFill" />
                <Image x:Name="BackdropB" Stretch="UniformToFill" />
                <Rectangle x:Name="Tint" Fill="Black" />
                <Rectangle x:Name="Frost" Fill="White" IsHitTestVisible="False" />
                <Image
                    x:Name="Noise"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    IsHitTestVisible="False"
                    Stretch="None" />
                <!-- Size-aware glass highlights drawn with composition shapes that follow the clip -->
                <Canvas x:Name="SheenHost" IsHitTestVisible="False" />

                <!-- Collapsed: single row -->
                <Grid
                    x:Name="CollapsedLayer"
                    Padding="6,0,12,0"
                    ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Border
                        x:Name="MiniCoverBorder"
                        Width="26"
                        Height="26"
                        VerticalAlignment="Center"
                        Background="#26FFFFFF"
                        CornerRadius="8">
                        <Image x:Name="MiniCover" Stretch="UniformToFill" />
                    </Border>

                    <Grid x:Name="TickerHost" Grid.Column="1" HorizontalAlignment="Left" VerticalAlignment="Center">
                        <controls:SweepText x:Name="TickerA" VerticalAlignment="Center" />
                        <controls:SweepText x:Name="TickerB" VerticalAlignment="Center" />
                    </Grid>

                    <!-- Volume HUD: briefly replaces the ticker when the volume changes while collapsed -->
                    <Grid
                        x:Name="VolumeHud"
                        Grid.Column="1"
                        Grid.ColumnSpan="2"
                        VerticalAlignment="Center"
                        ColumnSpacing="10"
                        IsHitTestVisible="False">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon x:Name="HudGlyph" FontFamily="{StaticResource IconFont}" FontSize="13" Glyph="&#xE995;" />
                        <Grid Grid.Column="1" Height="4" VerticalAlignment="Center">
                            <Rectangle Fill="#2EFFFFFF" RadiusX="2" RadiusY="2" />
                            <Rectangle x:Name="HudFill" Fill="White" RadiusX="2" RadiusY="2" />
                        </Grid>
                        <TextBlock x:Name="HudText" Grid.Column="2" MinWidth="28" FontSize="12" FontWeight="SemiBold" TextAlignment="Right" />
                    </Grid>

                    <StackPanel
                        x:Name="MiniVisualizer"
                        Grid.Column="2"
                        Height="16"
                        VerticalAlignment="Center"
                        Orientation="Horizontal"
                        Spacing="2.5">
                        <Rectangle Width="3" Height="16" RadiusX="1.5" RadiusY="1.5" />
                        <Rectangle Width="3" Height="16" RadiusX="1.5" RadiusY="1.5" />
                        <Rectangle Width="3" Height="16" RadiusX="1.5" RadiusY="1.5" />
                        <Rectangle Width="3" Height="16" RadiusX="1.5" RadiusY="1.5" />
                    </StackPanel>

                    <StackPanel
                        x:Name="MiniControls"
                        Grid.Column="2"
                        Margin="0,0,-6,0"
                        VerticalAlignment="Center"
                        Orientation="Horizontal"
                        Visibility="Collapsed">
                        <Button Width="30" Height="30" Click="OnPreviousClick" Style="{StaticResource IslandIconButtonStyle}">
                            <FontIcon FontFamily="{StaticResource IconFont}" FontSize="12" Glyph="&#xE892;" />
                        </Button>
                        <Button Width="30" Height="30" Click="OnPlayPauseClick" Style="{StaticResource IslandIconButtonStyle}">
                            <FontIcon x:Name="MiniPlayGlyph" FontFamily="{StaticResource IconFont}" FontSize="14" Glyph="&#xE768;" />
                        </Button>
                        <Button Width="30" Height="30" Click="OnNextClick" Style="{StaticResource IslandIconButtonStyle}">
                            <FontIcon FontFamily="{StaticResource IconFont}" FontSize="12" Glyph="&#xE893;" />
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- Expanded: now-playing card + lyrics -->
                <Grid x:Name="ExpandedLayer">
                    <Grid.RowDefinitions>
                        <RowDefinition x:Name="CardRow" Height="212" />
                        <RowDefinition x:Name="LyricsRow" Height="236" />
                    </Grid.RowDefinitions>

                    <Grid
                        x:Name="NowPlayingCard"
                        Padding="18,16,14,8"
                        Background="Transparent"
                        RowSpacing="8"
                        PointerReleased="OnCardPointerReleased">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="64" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid ColumnSpacing="14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="64" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border
                                x:Name="CoverBorder"
                                Width="64"
                                Height="64"
                                Background="#26FFFFFF"
                                CornerRadius="14">
                                <Grid>
                                    <FontIcon
                                        x:Name="CoverPlaceholder"
                                        FontFamily="{StaticResource IconFont}"
                                        FontSize="24"
                                        Foreground="#80FFFFFF"
                                        Glyph="&#xE8D6;" />
                                    <Image x:Name="Cover" Stretch="UniformToFill" />
                                </Grid>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                                <TextBlock
                                    x:Name="TitleText"
                                    FontSize="16"
                                    FontWeight="SemiBold"
                                    MaxLines="1"
                                    TextTrimming="CharacterEllipsis" />
                                <TextBlock
                                    x:Name="ArtistText"
                                    FontSize="13"
                                    MaxLines="1"
                                    Opacity="0.65"
                                    TextTrimming="CharacterEllipsis" />
                                <TextBlock
                                    x:Name="SourceText"
                                    Margin="0,2,0,0"
                                    FontSize="11"
                                    MaxLines="1"
                                    Opacity="0.4"
                                    TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" VerticalAlignment="Top" Orientation="Horizontal">
                                <Button
                                    x:Name="PinButton"
                                    Click="OnPinClick"
                                    Style="{StaticResource IslandIconButtonStyle}"
                                    ToolTipService.ToolTip="置顶面板：移开鼠标也不收起">
                                    <FontIcon x:Name="PinGlyph" FontFamily="{StaticResource IconFont}" FontSize="14" Glyph="&#xE718;" />
                                </Button>
                                <Button
                                    x:Name="FavoriteButton"
                                    Click="OnFavoriteClick"
                                    Style="{StaticResource IslandIconButtonStyle}"
                                    ToolTipService.ToolTip="红心收藏">
                                    <FontIcon x:Name="FavoriteGlyph" FontFamily="{StaticResource IconFont}" FontSize="16" Glyph="&#xEB51;" />
                                </Button>
                            </StackPanel>
                        </Grid>

                        <Grid Grid.Row="1" ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="40" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="40" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="ElapsedText" VerticalAlignment="Center" FontSize="11" Opacity="0.55" Text="0:00" />
                            <controls:ScrubBar x:Name="ProgressBar" Grid.Column="1" />
                            <TextBlock
                                x:Name="RemainingText"
                                Grid.Column="2"
                                VerticalAlignment="Center"
                                FontSize="11"
                                Opacity="0.55"
                                Text="-0:00"
                                TextAlignment="Right" />
                        </Grid>

                        <Grid Grid.Row="2">
                            <Button
                                x:Name="LyricsButton"
                                HorizontalAlignment="Left"
                                Click="OnLyricsClick"
                                Style="{StaticResource IslandIconButtonStyle}"
                                ToolTipService.ToolTip="歌词">
                                <FontIcon FontFamily="{StaticResource IconFont}" FontSize="15" Glyph="&#xE8FD;" />
                            </Button>
                            <StackPanel HorizontalAlignment="Center" Orientation="Horizontal" Spacing="14">
                                <Button Width="42" Height="42" CornerRadius="21" Click="OnPreviousClick" Style="{StaticResource IslandIconButtonStyle}">
                                    <FontIcon FontFamily="{StaticResource IconFont}" FontSize="18" Glyph="&#xE892;" />
                                </Button>
                                <Button Width="48" Height="48" CornerRadius="24" Click="OnPlayPauseClick" Style="{StaticResource IslandIconButtonStyle}">
                                    <FontIcon x:Name="PlayGlyph" FontFamily="{StaticResource IconFont}" FontSize="24" Glyph="&#xE768;" />
                                </Button>
                                <Button Width="42" Height="42" CornerRadius="21" Click="OnNextClick" Style="{StaticResource IslandIconButtonStyle}">
                                    <FontIcon FontFamily="{StaticResource IconFont}" FontSize="18" Glyph="&#xE893;" />
                                </Button>
                            </StackPanel>
                            <Button
                                HorizontalAlignment="Right"
                                Click="OnOpenPlayerClick"
                                Style="{StaticResource IslandIconButtonStyle}"
                                ToolTipService.ToolTip="打开播放器">
                                <FontIcon FontFamily="{StaticResource IconFont}" FontSize="14" Glyph="&#xE8A7;" />
                            </Button>
                        </Grid>

                        <!-- Volume -->
                        <Grid Grid.Row="3" Margin="-8,0,0,0" ColumnSpacing="6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="40" />
                            </Grid.ColumnDefinitions>
                            <Button
                                Width="30"
                                Height="30"
                                Click="OnMuteClick"
                                Style="{StaticResource IslandIconButtonStyle}"
                                ToolTipService.ToolTip="静音">
                                <FontIcon x:Name="VolumeGlyph" FontFamily="{StaticResource IconFont}" FontSize="13" Glyph="&#xE995;" />
                            </Button>
                            <controls:ScrubBar x:Name="VolumeBar" Grid.Column="1" />
                            <TextBlock
                                x:Name="VolumeText"
                                Grid.Column="2"
                                VerticalAlignment="Center"
                                FontSize="11"
                                Opacity="0.55"
                                TextAlignment="Right" />
                        </Grid>
                    </Grid>

                    <controls:LyricsPanel x:Name="LyricsView" Grid.Row="1" />
                    <controls:LyricFlowPanel x:Name="LyricFlow" Grid.Row="1" />
                </Grid>
            </Grid>

            <!-- Hairline glass edge drawn with a composition shape that tracks the clip -->
            <Canvas x:Name="EdgeHost" IsHitTestVisible="False" />
        </Grid>
    </Grid>
</Window>
